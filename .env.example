# PostgreSQL connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blood_app?schema=public"

# Public base URL of the app (used for links in emails/SMS and OAuth callbacks)
APP_URL="http://localhost:3000"

# Secrets: generate with `openssl rand -base64 32`
AUTH_SECRET="change-me"
ENCRYPTION_KEY="change-me-too"

# Comma separated emails that become admins automatically on first sign-in
ADMIN_EMAILS="admin@bloodapp.local"

# Protects /api/cron/* endpoints (send as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET="change-me"

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMS gateway (generic JSON POST: { to, message, sender_id }). Leave empty to log SMS to the console.
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="BloodApp"

# Email via Resend (https://resend.com). Leave empty to log emails to the console.
RESEND_API_KEY=""
EMAIL_FROM="Blood App <no-reply@bloodapp.local>"

# bKash tokenized checkout. Leave empty to use the built-in payment sandbox.
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# Set to "true" to allow the payment sandbox in production (never do this for real payments)
PAYMENT_SANDBOX="false"

# AI assistant (any OpenAI-compatible chat completions API). Leave empty for the built-in offline helper.
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Optional automatic NID / birth registration verification service
IDENTITY_VERIFY_URL=""
IDENTITY_VERIFY_KEY=""

# Where uploaded files are stored on disk
UPLOAD_DIR="./uploads"
